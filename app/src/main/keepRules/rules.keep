# Add project specific R8 rules here.
# AGP combines every keep rule file in src/main/keepRules and passes them to R8.

-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# SceneId and the other catalog enums are resolved from JSON by name at runtime, so their
# values() / valueOf() must survive shrinking or the whole catalog fails to load.
-keepclassmembers enum com.pixel.oceanfacts.core.** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
    <fields>;
}
